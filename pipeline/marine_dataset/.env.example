# Copy this file to .env and provide your own credentials locally.
# Never commit real usernames, passwords, client secrets, API keys, or tokens.

MARINE_DATA_CONFIG=configs/default.yaml
MARINE_DATA_SEED=42
MARINE_DATA_LICENCE_ON_INCOMPATIBLE=warn

# Copernicus Data Space Ecosystem (only if the selected access flow requires it)
CDSE_USERNAME=replace_with_your_username
CDSE_PASSWORD=replace_with_your_password

# Sentinel Hub (optional; only when its terms permit the intended workload)
SH_CLIENT_ID=replace_with_your_client_id
SH_CLIENT_SECRET=replace_with_your_client_secret

# Copernicus Marine Service
CMEMS_USERNAME=replace_with_your_username
CMEMS_PASSWORD=replace_with_your_password

# Optional provider overrides. Keep official defaults in application code/config.
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com
EMODNET_BASE_URL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Global Fishing Watch authorised API token (optional)
GFW_TOKEN=replace_with_your_token
