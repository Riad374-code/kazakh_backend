# Copy this file to .env and provide your own credentials locally.
# Never commit real usernames, passwords, client secrets, API keys, or tokens.

MARINE_DATA_CONFIG=configs/default.yaml
MARINE_DATA_SEED=42
MARINE_DATA_LICENCE_ON_INCOMPATIBLE=warn

# Copernicus Data Space Ecosystem (optional)
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_TOTP=

# Copernicus Marine Toolbox login (optional)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ESA SNAP GPT executable (optional; needed for real SAR preprocessing)
SNAP_GPT=
