# VCS
.git
.gitignore

# Python bytecode / caches
**/__pycache__/
**/*.py[cod]
**/.ruff_cache/
**/.pytest_cache/
**/.coverage
**/*.egg-info/

# Virtual environments
**/.venv/
**/venv/
**/env/

# Data-engineering pipeline is NOT part of the web service deployment.
# It is a heavy CLI tool (geo-stack + Copernicus credentials) run separately.
pipeline/

# Local secrets - never baked into the image
**/.env
**/.env.*
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Runtime SQLite store is regenerated on boot from committed checkpoints
KazakhAI_ML_Gemini/data/

# Docs / scratch (not needed in the container)
REMAINING_PROJECT_TASKS.md
frontend_integ.md
pipeline_inst.md
*.log
